$TTL 604800
@   IN  SOA dns1.linux.local. root.linux.local. (
            2025121401  ; Serial
            604800      ; Refresh
            86400       ; Retry
            2419200     ; Expire
            604800 )    ; Negative Cache TTL

; Servidores de Nomes e Registos de Endereco
@           IN  NS      dns1.linux.local.
@           IN  NS      dns2.linux.local.

dns1        IN  A       192.168.64.200
dns2        IN  A       192.168.64.201
dhcp1       IN  A       192.168.64.100
dhcp2       IN  A       192.168.64.101
wstation    IN  A       192.168.64.90
www         IN  CNAME   wstation
